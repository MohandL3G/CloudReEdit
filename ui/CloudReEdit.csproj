<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\CloudReEdit.ico</ApplicationIcon>
    <RootNamespace>CloudReEdit</RootNamespace>
    <AssemblyName>CloudReEdit</AssemblyName>
    <!-- Single source of the app version: VersionPrefix + VersionSuffix feeds the
         assembly/file version (numeric 0.2.7.0) and the informational version
         shown in the UI footer and the logs (0.2.7-pre-release). Drop the
         VersionSuffix line for the next stable release. -->
    <VersionPrefix>0.2.7</VersionPrefix>
    <VersionSuffix>pre-release</VersionSuffix>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\CloudReEdit.ico" />
  </ItemGroup>

</Project>
