<ui:FluentWindow x:Class="CloudReEdit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:CloudReEdit.Pages"
        Title="CloudReEdit"
        Icon="Assets/CloudReEdit.ico"
        Height="760" Width="1050"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="CloudReEdit">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/CloudReEdit.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           Transition="None"
                           TransitionDuration="0">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavAccounts"
                                       Content="Accounts"
                                       Icon="{ui:SymbolIcon People24}"
                                       TargetPageType="{x:Type pages:AccountsPage}" />
                <ui:NavigationViewItem x:Name="NavGames"
                                       Content="Games"
                                       Icon="{ui:SymbolIcon Apps24}"
                                       TargetPageType="{x:Type pages:GamesPage}" />
                <ui:NavigationViewItem x:Name="NavEditor"
                                       Content="Playtime Editor"
                                       Icon="{ui:SymbolIcon Edit24}"
                                       TargetPageType="{x:Type pages:PlaytimeEditorPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.PaneFooter>
                <TextBlock x:Name="VersionItem"
                           Margin="16,10,16,12"
                           FontSize="12"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </ui:NavigationView.PaneFooter>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
