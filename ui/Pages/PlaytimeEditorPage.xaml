<Page x:Class="CloudReEdit.Pages.PlaytimeEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="860">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Playtime Editor"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <ui:Button Grid.Column="1" VerticalAlignment="Center"
                           Appearance="Secondary"
                           Content="Back to Games"
                           Click="Back_Click" />
            </Grid>

            <TextBlock x:Name="GameTitleText"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,8,0,0" />
            <TextBlock x:Name="GameSubText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,12" />

            <ui:InfoBar x:Name="WarningBar"
                        Title=""
                        Message=""
                        Severity="Warning"
                        IsClosable="True"
                        IsOpen="False"
                        Margin="0,0,0,12" />

            <!-- Total playtime -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Total playtime"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:TextBox x:Name="TotalBox"
                                    Width="140"
                                    Text="0"
                                    TextChanged="TotalBox_TextChanged" />
                        <TextBlock x:Name="UnitText"
                                   Text="minutes"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:ToggleSwitch x:Name="HoursSwitch"
                                         Content="Hours"
                                         Margin="20,0,0,0"
                                         VerticalAlignment="Center"
                                         Checked="HoursSwitch_Changed"
                                         Unchecked="HoursSwitch_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="DeviceSumText"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="If the total differs from the sum of devices, the difference is stored in the __migrated_localconfig balance on save."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Per-device breakdown -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Per-device breakdown"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:DataGrid x:Name="DevicesGrid"
                                 AutoGenerateColumns="False"
                                 CanUserAddRows="False"
                                 CanUserDeleteRows="False"
                                 HeadersVisibility="Column"
                                 CellEditEnding="DevicesGrid_CellEditEnding"
                                 MinHeight="140"
                                 Margin="0,10,0,0">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Header="Device"
                                                   Width="*"
                                                   Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Windows"
                                                   Width="100"
                                                   Binding="{Binding Windows, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Mac"
                                                   Width="80"
                                                   Binding="{Binding Mac, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Linux"
                                                   Width="80"
                                                   Binding="{Binding Linux, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Sum"
                                                   Width="90"
                                                   IsReadOnly="True"
                                                   Binding="{Binding Sum}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:TextBox x:Name="NewDeviceBox"
                                    PlaceholderText="Device name"
                                    Width="220" />
                        <ui:Button Content="Add device"
                                   Margin="8,0,0,0"
                                   Click="AddDevice_Click" />
                        <ui:Button Content="Remove selected"
                                   Appearance="Secondary"
                                   Margin="8,0,0,0"
                                   Click="RemoveDevice_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Last played -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Last played"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:CalendarDatePicker x:Name="LastPlayedPicker"
                                               Width="180" />
                        <ui:Button Content="Now"
                                   Margin="8,0,0,0"
                                   Appearance="Secondary"
                                   Click="Now_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:InfoBar x:Name="ResultBar"
                        Title=""
                        Message=""
                        Severity="Success"
                        IsClosable="True"
                        IsOpen="False"
                        Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="SaveButton"
                           Content="Save playtime"
                           Appearance="Success"
                           Icon="{ui:SymbolIcon Save24}"
                           Click="Save_Click" />
                <ui:Button Content="Reload"
                           Margin="8,0,0,0"
                           Appearance="Secondary"
                           Click="Reload_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
