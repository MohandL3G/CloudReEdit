<Page x:Class="CloudReEdit.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="800">
            <TextBlock Text="Accounts"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Pick the Steam account whose playtime you want to edit."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Steam installation"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                    <TextBlock x:Name="SteamPathText"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Cloud provider"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                    <TextBlock x:Name="ProviderText"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Account"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ComboBox x:Name="AccountCombo"
                                  MinWidth="320"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="AccountCombo_SelectionChanged" />
                        <ui:Button Content="Refresh" Margin="8,0,0,0"
                                   Click="Refresh_Click" />
                    </StackPanel>

                    <TextBlock x:Name="SteamRunningText"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="CloseSteamButton"
                                   Content="Close Steam"
                                   Click="CloseSteam_Click" />
                        <ui:Button Content="Restart Steam"
                                   Margin="8,0,0,0"
                                   Click="RestartSteam_Click" />
                        <ui:Button x:Name="OpenGamesButton"
                                   Content="Open Games"
                                   Appearance="Primary"
                                   Margin="16,0,0,0"
                                   IsEnabled="False"
                                   Click="OpenGames_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
